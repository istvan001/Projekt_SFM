<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.myapplication.controller.RegisterController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #f1f5f9;">

    <padding>
        <Insets top="30" right="40"
                bottom="30" left="40"/>
    </padding>

    <Label text="JegyGo"
           style="-fx-font-size: 36px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #2563eb;"/>

    <Label text="Regisztráció"
           style="-fx-font-size: 20px;"/>

    <VBox alignment="CENTER"
          spacing="12"
          maxWidth="300">

        <TextField fx:id="nevField"
                   promptText="Teljes név"
                   maxWidth="Infinity"/>

        <TextField fx:id="emailField"
                   promptText="E-mail-cím"
                   maxWidth="Infinity"/>

        <PasswordField fx:id="passwordField"
                       promptText="Jelszó"
                       maxWidth="Infinity"/>

        <PasswordField fx:id="passwordAgainField"
                       promptText="Jelszó megerősítése"
                       maxWidth="Infinity"/>

        <Button text="Regisztráció"
                onAction="#regisztracio"
                maxWidth="Infinity"/>

        <Button text="Vissza a bejelentkezéshez"
                onAction="#vissza"
                maxWidth="Infinity"/>
    </VBox>
</VBox>
