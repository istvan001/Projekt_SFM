<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="18" style="-fx-background-color: #f1f5f9;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.myapplication.controller.Controller">

    <padding>
        <Insets bottom="25" left="30" right="30" top="25" />
    </padding>

    <Label style="-fx-font-size: 34px;                   -fx-font-weight: bold;                   -fx-text-fill: #2563eb;" text="JegyGo" />

    <Label style="-fx-font-size: 20px;" text="Járatok keresése" />

    <HBox alignment="CENTER" spacing="12">

        <VBox spacing="5">
            <Label text="Indulási hely" />
            <ComboBox fx:id="indulasCombo" prefWidth="180" promptText="Honnan?" />
        </VBox>

        <VBox spacing="5">
            <Label text="Célállomás" />
            <ComboBox fx:id="erkezesCombo" prefWidth="180" promptText="Hová?" />
        </VBox>


    </HBox>

    <HBox alignment="CENTER" spacing="12">
        <Label text="Utazás dátuma:" />
        <DatePicker fx:id="datumPicker" />

        <Button onAction="#jaratokKeresese" style="-fx-background-color: #2563eb;                        -fx-text-fill: white;                        -fx-font-size: 14px;" text="Járatok keresése" />
    </HBox>

    <Label style="-fx-font-size: 19px;                   -fx-font-weight: bold;" text="Elérhető járatok" />

    <TableView fx:id="jaratokTable" prefHeight="300" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="indulasColumn" prefWidth="140" text="Indulás" />

            <TableColumn fx:id="erkezesColumn" prefWidth="140" text="Érkezés" />

            <TableColumn fx:id="indulasIdoColumn" prefWidth="130" text="Indulási idő" />

            <TableColumn fx:id="erkezesIdoColumn" prefWidth="130" text="Érkezési idő" />

            <TableColumn fx:id="arColumn" prefWidth="100" text="Ár (Ft)" />

            <TableColumn fx:id="foglalasColumn" text="Művelet" prefWidth="130"  sortable="false"/>
        </columns>

    </TableView>

</VBox>
